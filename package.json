{
  "name": "engram",
  "version": "0.1.0",
  "description": "Memory traces for AI agents that strengthen with reinforcement",
  "type": "module",
  "main": "./dist/engram.js",
  "types": "./dist/engram.d.ts",
  "exports": {
    ".": {
      "import": "./dist/engram.js",
      "types": "./dist/engram.d.ts"
    },
    "./mcp-tools": {
      "import": "./dist/mcp-tools.js",
      "types": "./dist/mcp-tools.d.ts"
    }
  },
  "bin": {
    "engram-mcp": "./dist/mcp-server.js",
    "engram": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/schema.sql', 'dist/schema.sql')\"",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "dev": "tsx watch src/engram.ts",
    "reflect": "tsx src/reflect.ts",
    "example": "tsx examples/basic-usage.ts",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "^12.11.1",
    "sqlite-vec": "^0.1.6"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "fast-uri": "3.1.5",
    "hono": "4.13.3",
    "sharp": "0.35.3",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "memory",
    "ai",
    "agents",
    "sqlite",
    "vector-search",
    "knowledge-graph"
  ],
  "license": "Apache-2.0"
}
